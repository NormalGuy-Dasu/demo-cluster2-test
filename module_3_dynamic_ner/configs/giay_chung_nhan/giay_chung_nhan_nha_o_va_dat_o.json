{
    "document_type": "giay_chung_nhan_nha_o_va_dat_o",
    "document_name": "Giấy chứng nhận quyền sở hữu nhà ở và quyền sử dụng đất ở",
    "force_restart_on_same_trigger": true,
    "start_triggers": [
