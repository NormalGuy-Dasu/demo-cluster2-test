            "data_type": "string"
        },
        {
            "field_name": "ngay_thang_van_ban",
            "extraction_method": "proximity_number_search",
            "anchor_keywords": [
                "T.M Uỷ ban Nhân dân",
                "TM. Ủy ban nhân dân",
                "T.M Ủy ban nhân dân",
                "T.M Uy ban nhan dan"
            ],
            "scan_limit": 15,
            "scan_direction": "bottom_up",
            "look_up_lines": 2,
            "context_direction": "above",
            "date_format_mode": "text_only",
            "post_processing": [
                "fix_ocr_date_typos",
                "clean_targeted_punctuation",
                "format_date_vi"
            ]
        },
        {
            "field_name": "ten_loai_tai_lieu",
            "extraction_method": "fixed_string_with_conditional_append",
            "base_string": "Giấy chứng nhận quyền sở hữu nhà ở và quyền sử dụng đất ở",
            "conditions": [
                {
                    "keyword": "THU HỒI",
                    "append_string": " (Đã thu hồi)",
                    "threshold": 80
                },
                {
                    "keyword": "BẢN SAO",
                    "append_string": " (Bản sao)",
                    "threshold": 80
                },
                {
                    "keyword": "BANSAO",
                    "append_string": " (Bản sao)",
                    "threshold": 80
                }
            ]
        },
        {
            "field_name": "tac_gia",
            "extraction_method": "global_dictionary_match",
            "master_data": "dictionaries/dict_co_quan.txt",
            "match_threshold": 0.7
        }
    ]
